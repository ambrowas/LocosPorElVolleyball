rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: inscripciones_waiso_ipola
// Document ID: auto-generated
// Fields:
//   - nombre: string (required, 1..80 chars)
//   - apellidos: string (required, 1..120 chars)
//   - fechaNacimiento: string (required, 8..12 chars)
//   - edad: number (required, 4..30)
//   - sexo: string (required, enum: ['Masculino', 'Femenino'])
//   - telefono: string (required, 5..40 chars)
//   - centroEscolar: string (required, 1..120 chars)
//   - curso: string (required, 1..80 chars)
//   - quiereJugar: bool (required, must be true)
//   - fotoUrl: string (optional, 0..500000 chars)
//   - fotoPath: string (optional, 0..300 chars)
//   - categoria: string (optional, 0..60 chars)
//   - folio: string (optional, 0..30 chars)
//   - estado: string (optional, 0..30 chars)
//   - createdAt: timestamp (required, immutable on update)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    function isValidInscripcionWaiso(data) {
      let allowedFields = [
        'nombre',
        'apellidos',
        'sexo',
        'fechaNacimiento',
        'edad',
        'categoria',
        'telefono',
        'centroEscolar',
        'curso',
        'quiereJugar',
        'fotoUrl',
        'fotoPath',
        'grupoTaller',
        'estado',
        'folio',
        'createdAt'
      ];
      let requiredFields = [
        'nombre',
        'apellidos',
        'sexo',
        'fechaNacimiento',
        'edad',
        'telefono',
        'centroEscolar',
        'curso',
        'quiereJugar',
        'createdAt'
      ];

      return hasOnlyAllowedFields(allowedFields) &&
        hasRequiredFields(requiredFields) &&
        validStringLength('nombre', 1, 80) &&
        validStringLength('apellidos', 1, 120) &&
        data.sexo in ['Masculino', 'Femenino'] &&
        validStringLength('fechaNacimiento', 8, 12) &&
        data.edad is number && data.edad >= 4 && data.edad <= 35 &&
        validStringLength('telefono', 5, 40) &&
        validStringLength('centroEscolar', 1, 120) &&
        validStringLength('curso', 1, 80) &&
        data.quiereJugar is bool && data.quiereJugar == true &&
        data.createdAt is timestamp &&
        (!('fotoUrl' in data) || (data.fotoUrl is string && data.fotoUrl.size() <= 500000)) &&
        (!('fotoPath' in data) || (data.fotoPath is string && data.fotoPath.size() <= 300)) &&
        (!('categoria' in data) || (data.categoria is string && data.categoria.size() <= 60)) &&
        (!('grupoTaller' in data) || (data.grupoTaller is string && data.grupoTaller.size() <= 60)) &&
        (!('folio' in data) || (data.folio is string && data.folio.size() <= 30)) &&
        (!('estado' in data) || (data.estado is string && data.estado.size() <= 30));
    }

    match /inscripciones_waiso_ipola/{inscripcionId} {
      allow read: if true;
      allow create: if isValidInscripcionWaiso(request.resource.data);
      allow update: if isValidInscripcionWaiso(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
